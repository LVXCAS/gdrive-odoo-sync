# systemd unit for DriftWatch, for when the service moves off Windows.
#
#   sudo cp deploy/driftwatch.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now driftwatch
#   journalctl -u driftwatch -f
#
# Edit User, WorkingDirectory and ExecStart to match the install.

[Unit]
Description=DriftWatch: read-only Google Drive vs Odoo verification
Documentation=https://github.com/LVXCAS/gdrive-odoo-sync
# Drive and Odoo are both remote; starting before the network is up just
# produces a failed first cycle and a backoff.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=driftwatch
Group=driftwatch
WorkingDirectory=/opt/gdrive-odoo-sync
ExecStart=/opt/gdrive-odoo-sync/.venv/bin/python -m driftwatch daemon
# The daemon handles SIGTERM: it finishes the phase it is in and exits rather
# than being killed mid-write. Give it room to do that before SIGKILL.
KillSignal=SIGTERM
TimeoutStopSec=300
Restart=always
RestartSec=30
# Unbuffered, so journalctl shows the cycle as it happens rather than in
# 4KB gulps.
Environment=PYTHONUNBUFFERED=1

# The process reads Drive and Odoo over HTTPS and writes one SQLite file.
# Nothing else needs to be reachable.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/gdrive-odoo-sync
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
