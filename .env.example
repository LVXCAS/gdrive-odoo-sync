# DriftWatch configuration. Copy to `.env` and fill in.
#
#   copy .env.example .env
#
# `.env` is gitignored and must stay that way: the values below are bearer
# credentials. Real environment variables win over this file, so a service
# host can override any of it without editing anything.

# --------------------------------------------------------------------------
# Google
# --------------------------------------------------------------------------
# Path to the service-account JSON key. A path, not the JSON itself: the key
# is a bearer credential for the whole impersonated Drive corpus, and a file
# the process reads once has a smaller blast radius than a variable that
# shows up in `ps`, process dumps and crash reports.
DRIFTWATCH_SA_KEY=C:\path\to\service-account-key.json

# The Workspace user to impersonate. Domain-wide delegation must be authorized
# for the key's NUMERIC OAuth2 client id (not its ...iam.gserviceaccount.com
# email -- that mix-up is the most common setup error), with exactly:
#   https://www.googleapis.com/auth/drive.readonly,
#   https://www.googleapis.com/auth/spreadsheets.readonly
# Consumer @gmail.com accounts cannot be impersonated this way.
DRIFTWATCH_SUBJECT=you@yourdomain.com

# --------------------------------------------------------------------------
# Odoo  (read-only; nothing here is ever written to)
# --------------------------------------------------------------------------
ODOO_URL=https://yourdb.odoo.com
# Defaults to the subdomain of ODOO_URL when unset.
#ODOO_DB=yourdb
ODOO_LOGIN=you@yourdomain.com
ODOO_API_KEY=

# --------------------------------------------------------------------------
# Unattended operation
# --------------------------------------------------------------------------
# Seconds between cycles; accepts 900, 15m, 2h, 1d.
DRIFTWATCH_INTERVAL=1h

# Where the daily-rotated log goes, and how many days are kept.
#DRIFTWATCH_LOG_DIR=C:\Users\you\gdrive-odoo-sync\logs
#DRIFTWATCH_LOG_RETAIN=14

# The datastore. Holds a copy of real staged Drive content, not a cache --
# keep it on this machine and off any sync folder.
#DRIFTWATCH_DB=C:\Users\you\gdrive-odoo-sync\driftwatch.sqlite3

# --------------------------------------------------------------------------
# Drift digest email
# --------------------------------------------------------------------------
# Leave DRIFTWATCH_SMTP_HOST or DRIFTWATCH_ALERT_TO empty and alerting is off;
# the service still runs and still records every finding.
#
# Mail goes out when the SET OF FINDINGS CHANGES, not every cycle -- including
# when drift clears. An hourly mail that says the same thing every hour is a
# mail you stop reading.
#
# Gmail: use an App Password (myaccount.google.com/apppasswords), not your
# account password. Requires 2-Step Verification to be on.
DRIFTWATCH_SMTP_HOST=smtp.gmail.com
DRIFTWATCH_SMTP_PORT=587
DRIFTWATCH_SMTP_USER=you@gmail.com
DRIFTWATCH_SMTP_PASSWORD=
# 587 = STARTTLS (default). Set port 465 for implicit TLS.
#DRIFTWATCH_SMTP_STARTTLS=true
# Most providers reject a From: that is not the authenticated mailbox.
#DRIFTWATCH_ALERT_FROM=you@gmail.com
# Comma-separated.
DRIFTWATCH_ALERT_TO=you@gmail.com

# --------------------------------------------------------------------------
# Guardrails (defaults are sane; change only with a reason)
# --------------------------------------------------------------------------
#DRIFTWATCH_MAX_FILES=0
#DRIFTWATCH_SHEETS_RPM=60
#DRIFTWATCH_DRIVE_RPM=300
